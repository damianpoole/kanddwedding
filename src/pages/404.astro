---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404: Not found">
  <div class="message">
    <h1>NOT FOUND</h1>
    <p>You just hit a route that doesn’t exist... the sadness.</p>
    <p><a href="/">Return to the wedding website</a></p>
  </div>
</Layout>

<style>
  .message { max-width: 1024px; margin: 0 auto; padding: 2rem; }
</style>
